# Default provider (huggingface is free, generates 2D concept art)
MODEL_PROVIDER=huggingface

# Optional: For 3D model generation, get free trial API keys from:
# Meshy AI: https://meshy.ai (recommended - 200 free credits)
# Tripo AI: https://tripo3d.ai

MESHY_API_KEY=your_meshy_api_key_here
TRIPO_API_KEY=your_tripo_api_key_here
HUGGINGFACE_TOKEN=optional_for_higher_rate_limits
